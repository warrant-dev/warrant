        {
            "name": "checkUserStephenMemberPartnerTestpart",
            "request": {
                "method": "POST",
                "url": "/v2/check",
                "headers": {
                    "Warrant-Token": "latest"
                },
                "body": {
                    "op": "anyOf",
                    "warrants": [
                        {
                            "objectType": "partner",
                            "objectId": "testpart",
                            "relation": "member",
                            "subject": {
                                "objectType": "user",
                                "objectId": "stephen"
                            }
                        }
                    ]
                }
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "code": 200,
                    "result": "Authorized",
                    "isImplicit": true
                }
            }
        },
