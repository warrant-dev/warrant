{
    "ignoredFields": [
        "createdAt",
        "processingTime"
    ],
    "tests": [
        {
            "name": "createPartnerObjectType",
            "request": {
                "method": "POST",
                "url": "/v2/object-types",
                "body": {
                    "type": "partner",
                    "relations": {
                        "parent": {},
                        "member": {
                            "inheritIf": "admin",
                            "withRelation": "parent",
                            "ofType": "tenant"
                        }
                    }
                }
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "type": "partner",
                    "relations": {
                        "parent": {},
                        "member": {
                            "inheritIf": "admin",
                            "ofType": "tenant",
                            "withRelation": "parent"
                        }
                    }
                }
            }
        },
        {
            "name": "createAccountObjectType",
            "request": {
                "method": "POST",
                "url": "/v2/object-types",
                "body": {
                    "type": "account",
                    "relations": {
                        "owner": {},
                        "member": {
                            "inheritIf": "member",
                            "withRelation": "owner",
                            "ofType": "partner"
                        }
                    }
                }
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "type": "account",
                    "relations": {
                        "owner": {},
                        "member": {
                            "inheritIf": "member",
                            "ofType": "partner",
                            "withRelation": "owner"
                        }
                    }
                }
            }
        },
